# Copie este arquivo para .env e ajuste os valores do seu ambiente.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL do docker-compose (docker compose up -d db).
# Para rodar sem Docker, use: DATABASE_URL=sqlite:///./tarefas.db
DATABASE_URL=postgresql+psycopg://tarefas:tarefas@localhost:5432/tarefas

# Gere um segredo com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
JWT_EXPIRATION_MINUTES=60

# Notificações por e-mail: "log" (simula no log) ou "smtp" (envia de verdade).
# Com "docker compose up -d mailpit", use smtp + localhost:1025 e veja em http://localhost:8025
NOTIFICATION_BACKEND=log
SMTP_HOST=localhost
SMTP_PORT=1025
