      "get": {
        "tags": [
          "Tarefas"
        ],
        "summary": "Listar e filtrar tarefas",
        "description": "Todos os filtros são opcionais e combináveis, por exemplo `/tasks?status=done&priority=high&dueBefore=2026-12-01`. `dueBefore` e `dueAfter` são exclusivos e ignoram tarefas sem prazo. O resultado é paginado (`limit`, padrão 50, máximo 100) e ordenado da tarefa mais recente para a mais antiga.",
        "operationId": "list_tasks_tasks_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "assignedTo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Somente tarefas deste responsável",
              "title": "Assignedto"
            },
            "description": "Somente tarefas deste responsável"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TaskStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TaskPriority"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Priority"
            }
          },
          {
            "name": "dueBefore",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Prazo anterior a esta data",
              "title": "Duebefore"
            },
            "description": "Prazo anterior a esta data"
          },
          {
            "name": "dueAfter",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Prazo posterior a esta data",
              "title": "Dueafter"
            },
            "description": "Prazo posterior a esta data"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskResponse"
