{
  "openapi": "3.1.0",
  "info": {
    "title": "API de Gestão de Tarefas Colaborativas",
    "description": "\nAPI REST para gestão de tarefas colaborativas: usuários criam, editam, atribuem e concluem\ntarefas.\n\n**Como autenticar:** crie um usuário em `POST /users`, faça login em `POST /auth/login` e\ninforme o `access_token` no botão **Authorize** (cabeçalho `Authorization: Bearer <token>`).\n",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Autenticar usuário",
        "description": "Valida e-mail e senha e devolve um token JWT para as demais requisições.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido, expirado ou revogado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos ou regra de negócio violada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Encerrar sessão",
        "description": "Revoga o token usado na requisição; ele deixa de ser aceito imediatamente.",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Token ausente, inválido, expirado ou revogado",
            "content": {
